{
  "name": "e2d — Elastic to Dynatrace",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e .",
  "postStartCommand": "nohup e2d web --no-browser > /tmp/e2d-web.log 2>&1 &",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "e2d web GUI",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
